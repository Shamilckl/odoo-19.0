<odoo>
    <record id="appointment_wizard_form" model="ir.ui.view">
        <field name="name">book.appt.form</field>
        <field name="model">book.appt</field>
        <field name="arch" type="xml">
            <form string="Create Appointment">
                <group>
                    <field name="patient_name"/>
                    <field name="doctor_name"/>
                </group>
                <footer>
                    <button
                        name="action_create_appointment"
                        type="object"
                        string="Create Appointment"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>