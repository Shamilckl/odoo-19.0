<odoo>
     <record id="lab_pharmacy_form_view" model="ir.ui.view">
        <field name="name">lab.pharmacy.form</field>
        <field name="model">lab.pharmacy</field>
        <field name="arch" type="xml">
            <form string="Pharmacy">
                <sheet>
                    <group>
                        <field name="patient_name" readonly="1"/>
                        <field name="doctor_name" readonly="1"/>
                        <field name="consultation_date" readonly="1"/>
                    </group>
                    <field name="product_line_ids" readonly="1">
                        <list>
                            <field name="product_name"/>
                            <field name="comment"/>
                            <field name="days"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                    <div class="text-end">
                        <label for="price_total" string="Total :"/>
                        <field name="price_total" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pharmacy_action" model="ir.actions.act_window">
        <field name="name">Pharmacy</field>
        <field name="res_model">lab.pharmacy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>