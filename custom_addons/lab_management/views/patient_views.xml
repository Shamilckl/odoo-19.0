<odoo>

    <record id="patient_list" model="ir.ui.view">
        <field name="name">lab.patient.list</field>
        <field name="model">lab.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_name"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone_number"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="patient_form" model="ir.ui.view">
        <field name="name">lab.patient.form</field>
        <field name="model">lab.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_appointment_wizard"
                        type="object"
                        string="Create Appointment"
                        class="btn-primary"
                        groups="lab_management.operational_head"/>
                </header>
                <sheet>

                    <group>
                        <field name="patient_id"/>
                        <field name="patient_name"/>
                        <field name="date_of_birth"/>
                        <field name="age"/>
                        <field name="gender"/>
                        <field name="phone_number"/>
                        <field name="email"/>
                        <field name="is_donor"/>
                        <field name="is_test_bool"/>
<!--                        <field name="blood_group2" invisible="not is_donor"/>-->
                        <field name="blood_group2"/>
                        <field name="active"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="patients_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">lab.patient</field>
        <field name="view_mode">list,form</field>
         <field name="context">{'active_test': False}</field>
    </record>

</odoo>