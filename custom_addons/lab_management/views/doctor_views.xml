<odoo>

    <record id="doctor_list" model="ir.ui.view">
        <field name="name">lab.doctor.list</field>
        <field name="model">lab.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
<!--                <field name="doctor_name"/>-->
                <field name="medical_license_number"/>
            </list>
        </field>
    </record>

    <record id="doctor_form" model="ir.ui.view">
        <field name="name">lab.doctor.form</field>
        <field name="model">lab.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
<!--                        <field name="doctor_name"/>-->
                        <field name="doctor_id"/>
                        <field name="profile_img2" widget="image" class="oe_avatar"/>
                        <field name="specialization"/>
                        <field name="medical_license_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">lab.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>