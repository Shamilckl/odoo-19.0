<odoo>
    <record id="operational_head" model="res.groups">
        <field name="name">Operational Head</field>
    </record>

    <record id="group_lab_doctor" model="res.groups">
        <field name="name">Doctor</field>
    </record>

    <record id="appointment_rule_doctor" model="ir.rule">
        <field name="name">Doctor - Own Confirmed Appointments</field>
        <field name="model_id" ref="model_lab_appointment"/>
        <field name="domain_force">[('doctor_name.user_id', '=', user.id), ('state', '=', 'confirmed')]</field>
        <field name="groups" eval="[(4, ref('group_lab_doctor'))]"/>
    </record>

        <record id="appointment_rule_admin" model="ir.rule">
            <field name="name">Admin - All Appointments</field>
            <field name="model_id" ref="model_lab_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_lab_doctor'))]"/>
        </record>

    <record id="group_prescription" model="res.groups">
        <field name="name">View Prescription</field>
    </record>



</odoo>