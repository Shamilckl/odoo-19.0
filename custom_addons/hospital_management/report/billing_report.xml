<odoo>
    <template id="billing_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Billing Slip</h2>

                        <p><strong>Patient:</strong>
                            <span t-field="doc.patient_id"/>
                        </p>

                        <p><strong>Consultation Fee:</strong>
                            <span t-field="doc.consultation_fee"/>
                        </p>

                        <p><strong>Room Rent:</strong>
                            <span t-field="doc.room_rent"/>
                        </p>

                        <p><strong>Medicine Total:</strong>
                            <span t-field="doc.medicine_total"/>
                        </p>

                        <p><strong>Laboratory Charge:</strong>
                            <span t-field="doc.laboratory_charge"/>
                        </p>
                         <p><strong>Total Amount:</strong>
                            <span t-field="doc.total_amount"/>
                        </p>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>