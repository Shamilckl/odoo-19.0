<odoo>
    <record id="medicine_list" model="ir.ui.view">
        <field name="name">hospital.medicine.list</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="medicine"/>
                <field name="qty"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="medicine_form" model="ir.ui.view">
        <field name="name">hospital.medicine.form</field>
        <field name="model">hospital.medicine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="medicine"/>
                        <field name="qty"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medicine_action" model="ir.actions.act_window">
        <field name="name">Medicine</field>
        <field name="res_model">hospital.medicine</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>