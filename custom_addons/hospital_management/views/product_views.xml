<odoo>

    <record id="product_template_form_inherit_medicine" model="ir.ui.view">
        <field name="name">product.template.form.medicine</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-flex" invisible="type == 'combo'">
                    <field name="is_medicine"/>
                    <label for="is_medicine"/>
                </span>
            </div>
            <xpath expr="//field[@name='company_id']" position="after">
                    <field name="fiscal_country_codes" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>