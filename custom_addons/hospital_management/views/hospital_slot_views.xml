<odoo>

    <record id="slot_list" model="ir.ui.view">
        <field name="name">hospital.slot.list</field>
        <field name="model">hospital.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_time"/>
                <field name="start_period"/>
                <field name ='end_time'/>
                <field name="end_period"/>
            </list>
        </field>
    </record>

    <record id="slot_form" model="ir.ui.view">
        <field name="name">hospital.slot.form</field>
        <field name="model">hospital.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="start_period"/>
                        </group>
                        <group>
                            <field name="end_time" widget="float_time"/>
                            <field name="end_period"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="slot_action" model="ir.actions.act_window">
        <field name="name">Slots</field>
        <field name="res_model">hospital.slot</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>