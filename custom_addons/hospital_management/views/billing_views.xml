<odoo>

    <record id="billing_list" model="ir.ui.view">
        <field name="name">hospital.billing.list</field>
        <field name="model">hospital.billing</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <record id="billing_form" model="ir.ui.view">
        <field name="name">hospital.billing.form</field>
        <field name="model">hospital.billing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="consultation_fee"/>
                        <field name="room_rent"/>
                        <field name="medicine_total"/>
                        <field name="laboratory_charge"/>
                        <field name="total_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="billing_action" model="ir.actions.act_window">
        <field name="name">Billing</field>
        <field name="res_model">hospital.billing</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>