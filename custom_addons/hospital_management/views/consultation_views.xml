<odoo>

    <record id="consultation_list" model="ir.ui.view">
        <field name="name">hospital.consultation.list</field>
        <field name="model">hospital.consultation</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="doctor_id"/>
            </list>
        </field>
    </record>

    <record id="consultation_form" model="ir.ui.view">
        <field name="name">hospital.consultation.form</field>
        <field name="model">hospital.consultation</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button name="action_draft"
                            string="Cancel"
                            type="object"/>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <field name="state"
                           widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="diagnosis"/>
                    </group>

                    <notebook>
                        <page string="Medicines">
                            <field name="medicine_line_ids">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="quantity"/>
                                    <field name="dosage"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="consultation_action" model="ir.actions.act_window">
        <field name="name">Consultation</field>
        <field name="res_model">hospital.consultation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>