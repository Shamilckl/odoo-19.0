<odoo>

    <record id="consultation_list" model="ir.ui.view">
        <field name="name">hospital.consultation.list</field>
        <field name="model">hospital.consultation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
            </list>
        </field>
    </record>

    <record id="consultation_form" model="ir.ui.view">
        <field name="name">hospital.consultation.form</field>
        <field name="model">hospital.consultation</field>
        <field name="arch" type="xml">
            <form>

                <header>

                    <button name="action_consultation"
                            string="Consultation"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'new'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'consultation'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state != 'new'"/>

                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                        </group>
                        <group>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="diagnosis"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Medicines">
                            <field name="medicine_line_ids">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="quantity"/>
                                    <field name="dosage"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="consultation_action" model="ir.actions.act_window">
        <field name="name">Consultation</field>
        <field name="res_model">hospital.consultation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>