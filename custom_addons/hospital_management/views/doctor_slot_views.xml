<odoo>
    <record id="doctor_slot_list" model="ir.ui.view">
        <field name="name">hospital.doctor.slot.list</field>
        <field name="model">hospital.doctor.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_time"/>
                <field name="end_time"/>
            </list>
        </field>
    </record>

    <record id="doctor_slot_form" model="ir.ui.view">
        <field name="name">hospital.doctor.slot.form</field>
        <field name="model">hospital.doctor.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>

                        <group>
                            <field name="start_time"/>
                        </group>

                        <group>
                            <field name="end_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="doctor_slot_action" model="ir.actions.act_window">
        <field name="name">Slots</field>
        <field name="res_model">hospital.doctor.slot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>