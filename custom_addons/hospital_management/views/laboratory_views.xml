<odoo>

    <record id="laboratory_list" model="ir.ui.view">
        <field name="name">hospital.laboratory.list</field>
        <field name="model">hospital.laboratory</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="test"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="laboratory_form" model="ir.ui.view">
        <field name="name">hospital.laboratory.form</field>
        <field name="model">hospital.laboratory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="test"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="laboratory_action" model="ir.actions.act_window">
        <field name="name">Laboratory</field>
        <field name="res_model">hospital.laboratory</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>