<odoo>

    <record id="appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="appointment_date"/>
                <field name="consulting_fee"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="slot_id"/>
            </list>
        </field>
    </record>

    <record id="appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>

                <header>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'confirm'"/>

                    <button name="action_draft"
                            string="Draft"
                            type="object"
                            invisible="state != 'new'"/>

                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_consultation"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope">

                            <field name="consultation_count"
                                   widget="statinfo"
                                   string="Consultation"/>

                        </button>

                        <button name="action_view_sale_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">

                            <field name="sale_order_count"
                                   widget="statinfo"
                                   string="Sales"/>

                        </button>

                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="appointment_date"/>
                            <field name="consulting_fee"/>
                            <field name="slot_id"/>
                        </group>
                    </group>

                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="appointment_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>